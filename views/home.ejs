<%- include('partials/head') %>

<section class="hero wrap">
  <div class="hero-copy">
    <p class="kicker">CSPC canteen pre-order</p>
    <h1>Skip the line. Your lunch is ready when you are.</h1>
    <p class="lead">Pick a stall, choose your food, and set a pickup time. Walk straight to the counter and pay when you collect it. No more watching the clock in a queue.</p>
    <div class="cta-row">
      <a class="btn btn--lg" href="/stalls">Pre-order now</a>
      <a class="btn btn--ghost btn--lg" href="#stalls">See the stalls</a>
    </div>
    <dl class="facts">
      <div><dt>Service hours</dt><dd>8:00–5:00</dd></div>
      <div><dt>Order ahead by</dt><dd>15 min+</dd></div>
      <div><dt>Stalls</dt><dd><%= stalls.length %></dd></div>
      <div><dt>Payment</dt><dd>At pickup</dd></div>
    </dl>
  </div>
  <div class="hero-visual" aria-hidden="true">
    <div class="plate">🍱</div>
    <div class="float float--a"><strong>Ready alert</strong><span>See “Ready for pickup” on your order</span></div>
    <div class="float float--b"><strong>No double-ups</strong><span>Cancel anytime while pending</span></div>
  </div>
</section>

<div class="strip" aria-hidden="true">
  <div class="track">
    <% const words = items.length ? items.slice(0, 14).map(i => i.name) : ['Viands', 'Snacks', 'Drinks']; %>
    <% for (let k = 0; k < 2; k++) { words.forEach(function (w) { %><span><%= w %></span><% }); } %>
  </div>
</div>

<section id="stalls" class="wrap section">
  <h2>Stalls taking pre-orders</h2>
  <% if (stalls.length === 0) { %>
    <p class="empty">No stalls have joined yet. Check back soon.</p>
  <% } else { %>
  <ul class="stall-grid">
    <% stalls.forEach(function (s) { %>
    <li class="stall-card">
      <div class="stall-top">
        <%- include('partials/pic', { file: s.logo, fallback: s.name.charAt(0).toUpperCase(), cls: 'logo' }) %>
        <h3><a href="/stalls/<%= s.id %>"><%= s.name %></a></h3>
      </div>
      <% if (s.location) { %><p class="meta"><%= s.location %></p><% } %>
      <% if (s.description) { %><p><%= s.description %></p><% } %>
      <p class="meta"><%= s.item_count %> item<%= Number(s.item_count) === 1 ? '' : 's' %> available</p>
    </li>
    <% }); %>
  </ul>
  <% } %>
</section>

<section class="wrap section">
  <h2>How it works</h2>
  <ol class="steps">
    <li><strong>Pick a stall and your food</strong><span>Menus are sorted by category. Enter a quantity for each item you want.</span></li>
    <li><strong>Choose a pickup time</strong><span>Any time between 8:00 and 5:00, at least 15 minutes ahead.</span></li>
    <li><strong>Collect and pay</strong><span>Show your reference number at the stall when the status says Ready.</span></li>
  </ol>
</section>

<section class="wrap section final">
  <h2>Hungry already?</h2>
  <a class="btn btn--lg btn--sun" href="/stalls">Start your order</a>
  <p>Run a stall in the canteen? <a href="/register/stall">Register your stall</a>.</p>
</section>

<%- include('partials/foot') %>
