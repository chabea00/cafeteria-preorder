<% const cur = (p, exact) => {
     if (typeof path === 'undefined') return '';
     return (((exact || p === '/') ? path === p : path.startsWith(p)) ? ' aria-current="page"' : '');
   }; %>
<nav aria-label="Main">
  <a class="brand" href="<%= (typeof user !== 'undefined' && user && user.role === 'stall') ? '/dashboard' : '/' %>">Dash<em>Line</em></a>
  <ul>
  <% if (typeof user !== 'undefined' && user && user.role === 'stall') { %>
    <!-- Stall Owner Links -->
    <li><a href="/dashboard"<%- cur('/dashboard', true) %>>Orders</a></li>
    <li><a href="/dashboard/menu"<%- cur('/dashboard/menu') %>>My menu</a></li>
    <li><a href="/dashboard/profile"<%- cur('/dashboard/profile') %>>Stall profile</a></li>
  <% } else { %>
    <!-- Guest, Student, and Staff Links (Identical) -->
    <li><a href="/"<%- cur('/', true) %>>Home</a></li>
    <li><a href="/stalls"<%- cur('/stalls') %>>Stalls</a></li>
    <% if (typeof user !== 'undefined' && user) { %>
      <li><a href="/orders"<%- cur('/orders') %>>My orders</a></li>
    <% } %>
  <% } %>
  </ul>
  
  <div class="nav-actions">
  <% if (typeof user !== 'undefined' && user) { %>
    <% if (user.role === 'student' || user.role === 'staff') { %>
      <a class="btn btn--sm" href="/stalls">Order now</a>
    <% } %>
    
    <!-- Logout is a simple GET link to prevent CSRF errors -->
    <a class="link" href="/logout">Log out (<%= user.name %>)</a>

  <% } else { %>
    <a class="link" href="/login">Log in</a>
    <a class="btn btn--sm" href="/register">Create account</a>
  <% } %>
  </div>
</nav>