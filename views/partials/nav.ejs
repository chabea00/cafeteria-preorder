<% const cur = (p) => ((p === '/' ? path === '/' : path.startsWith(p)) ? ' aria-current="page"' : ''); %>
<nav aria-label="Main">
  <a class="brand" href="/"><span class="mark" aria-hidden="true">🍴</span> Tray<em>Ahead</em></a>
  <ul>
  <% if (user && user.role !== 'student') { %>
    <li><a href="/staff"<%- cur('/staff') %>>Queue</a></li>
    <li><a href="/staff/menu"<%- cur('/staff/menu') %>>Menu</a></li>
  <% } else { %>
    <li><a href="/"<%- cur('/') %>>Home</a></li>
    <li><a href="/#menu">Menu</a></li>
    <% if (user) { %><li><a href="/orders"<%- cur('/orders') %>>My orders</a></li><% } %>
  <% } %>
  </ul>
  <div class="nav-actions">
  <% if (user) { %>
    <% if (user.role === 'student') { %><a class="btn btn--sm" href="/orders/new">Order now</a><% } %>
    <form method="POST" action="/logout" class="inline">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="link" type="submit">Log out (<%= user.name %>)</button>
    </form>
  <% } else { %>
    <a class="link" href="/login">Log in</a>
    <a class="btn btn--sm" href="/register">Create account</a>
  <% } %>
  </div>
</nav>