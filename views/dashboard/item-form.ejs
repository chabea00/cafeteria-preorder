<%- include('../partials/head') %>
<h1><%= title %></h1>
<%- include('../partials/errors', { errors }) %>
<form method="POST" action="<%= action %>" enctype="multipart/form-data" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label for="name">Item name</label>
  <input id="name" name="name" maxlength="80" required value="<%= old.name || '' %>">

  <label for="description">Short description (optional)</label>
  <textarea id="description" name="description" rows="2" maxlength="200"><%= old.description || '' %></textarea>

  <label for="category">Category</label>
  <select id="category" name="category" required>
    <option value="">— choose —</option>
    <% categories.forEach(function (c) { %><option value="<%= c %>" <%= old.category === c ? 'selected' : '' %>><%= c %></option><% }); %>
  </select>

  <label for="price">Price (₱)</label>
  <input id="price" name="price" type="number" min="0" max="9999.99" step="0.01" required value="<%= old.price === undefined ? '' : old.price %>">

  <% if (image) { %>
  <p class="preview-label">Current photo</p>
  <%- include('../partials/pic', { file: image, fallback: '🍴', cls: 'thumb thumb--lg' }) %>
  <label class="check"><input type="checkbox" name="remove_image" value="1"> Remove this photo</label>
  <% } %>
  <label for="image"><%= image ? 'Replace photo (optional)' : 'Photo (optional)' %></label>
  <input id="image" name="image" type="file" accept="image/jpeg,image/png,image/webp" aria-describedby="img-help">
  <small id="img-help">JPG, PNG or WebP, up to 2 MB. If the form shows an error, choose the photo again.</small>

  <label for="max_per_student">Most a student can order at once (optional)</label>
  <input id="max_per_student" name="max_per_student" type="number" min="1" max="10" aria-describedby="max-help" value="<%= old.max_per_student === undefined ? '' : old.max_per_student %>">
  <small id="max-help">Leave blank for the default of 10.</small>

  <label for="daily_limit">Daily pre-order limit (optional)</label>
  <input id="daily_limit" name="daily_limit" type="number" min="1" max="1000" aria-describedby="lim-help" value="<%= old.daily_limit === undefined ? '' : old.daily_limit %>">
  <small id="lim-help">Total pre-orders accepted per day. Once reached, the item is greyed out for students until tomorrow. Leave blank for no limit.</small>

  <label class="check"><input type="checkbox" name="available" value="1" <%= old.available ? 'checked' : '' %>> Available for pre-order</label>

  <button class="btn" type="submit">Save item</button>
  <a href="/dashboard/menu">Cancel</a>
</form>
<%- include('../partials/foot') %>
