<%- include('../partials/head') %>
<h1>Register your stall</h1>
<%- include('../partials/role-tabs', { tabs: [
  { label: 'Student', href: '/register', active: false },
  { label: 'Stall owner', href: '/register/stall', active: true } ] }) %>
<p class="notice">We collect your stall details and your name and e-mail only to show your stall to students, to let you manage your menu and orders, and to sign you in. Students see your stall name, location, description and menu. Your e-mail is never shown to them.</p>
<%- include('../partials/errors', { errors }) %>
<form method="POST" action="/register/stall" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label for="stall_name">Stall name</label>
  <input id="stall_name" name="stall_name" maxlength="80" required value="<%= old.name || '' %>">
  <label for="location">Location in the canteen (optional)</label>
  <input id="location" name="location" maxlength="80" value="<%= old.location || '' %>">
  <label for="description">Short description (optional)</label>
  <textarea id="description" name="description" rows="2" maxlength="200"><%= old.description || '' %></textarea>
  <label for="full_name">Owner or manager name</label>
  <input id="full_name" name="full_name" maxlength="120" autocomplete="name" required value="<%= old.fullName || '' %>">
  <label for="email">E-mail (you will log in with this)</label>
  <input id="email" name="email" type="email" maxlength="160" autocomplete="email" required value="<%= old.email || '' %>">
  <label for="password">Password</label>
  <input id="password" name="password" type="password" minlength="8" autocomplete="new-password" required aria-describedby="pw-help">
  <small id="pw-help">At least 8 characters.</small>
  <button class="btn" type="submit">Register stall</button>
</form>
<p>Already have an account? <a href="/login?as=stall">Log in</a>.</p>
<%- include('../partials/foot') %>
