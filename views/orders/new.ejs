<%- include('../partials/head') %>
<h1>Pre-order your meal</h1>
<%- include('../partials/errors', { errors }) %>
<form method="POST" action="/orders" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <% if (menu.length === 0) { %>
    <p class="empty">Nothing is available right now. Please check back later.</p>
  <% } else { %>
  <table>
    <caption class="sr-only">Menu. Enter a quantity from 0 to 10 for each item you want.</caption>
    <thead><tr><th scope="col">Item</th><th scope="col">Category</th><th scope="col">Price</th><th scope="col">Qty</th></tr></thead>
    <tbody>
    <% menu.forEach(function (m) { %>
      <tr>
        <th scope="row"><label for="qty-<%= m.id %>"><%= m.name %></label></th>
        <td><%= m.category %></td>
        <td>₱<%= Number(m.price).toFixed(2) %></td>
        <td><input id="qty-<%= m.id %>" class="qty" name="qty[<%= m.id %>]" type="number" min="0" max="10" inputmode="numeric" value="<%= (old.qty && old.qty[m.id]) || 0 %>"></td>
      </tr>
    <% }); %>
    </tbody>
  </table>
  <label for="pickup_time">Pickup time (today, 8:00–17:00)</label>
  <input id="pickup_time" name="pickup_time" type="time" min="08:00" max="17:00" required value="<%= old.pickup_time || '' %>">
  <label for="note">Note for the kitchen (optional)</label>
  <textarea id="note" name="note" rows="2" maxlength="200"><%= old.note || '' %></textarea>
  <button class="btn" type="submit">Place order</button>
  <% } %>
</form>
<%- include('../partials/foot') %>
